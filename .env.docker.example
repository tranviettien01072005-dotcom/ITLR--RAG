# Local full-stack Docker configuration (compose.local.yml).
# Copy: cp .env.docker.example .env.docker   → thay mọi giá trị REPLACE_* bằng secret ngẫu nhiên.
# Không commit .env.docker. Production dùng deploy/*.env.example riêng.

POSTGRES_DB=itlr
POSTGRES_USER=itlr
# openssl rand -hex 16 (chỉ hex để không phải URL-encode trong DATABASE_URL)
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_16

# openssl rand -hex 32 (Web từ chối nếu <32 ký tự hoặc chứa mẫu dev-secret/doi-thanh/change.me)
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
# openssl rand -hex 16 (>=16 ký tự)
ADMIN_PASSCODE=REPLACE_WITH_openssl_rand_hex_16
# openssl rand -hex 24 — bảo vệ POST /admin/reload và /metrics
ITLR_ADMIN_TOKEN=REPLACE_WITH_openssl_rand_hex_24

APP_ORIGIN=http://localhost:3000
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=240
DISABLE_RERANKER=1
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# Cổng host (tùy chọn, mặc định như bên dưới). Đổi nếu bị chiếm.
# POSTGRES_PORT=5432
# API_PORT=8000
# WEB_PORT=3000
# OLLAMA_PORT=11434

# Observability (compose.monitoring.yml + --profile monitoring)
# Grafana admin password (>=12 chars). Ports chỉ bind loopback.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_openssl_rand_hex_16
# Bật trace khi chạy monitoring profile (OTLP HTTP collector):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# TEMPO_PORT=3200
