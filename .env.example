# ===== Cấu hình ITLR RAG =====
# Copy thành `.env` (hoặc export biến môi trường trước khi chạy).
# KHÔNG commit file .env thật (chứa API key) vào git.

# --- LLM chính: DeepSeek (OpenAI-compatible SDK) ---
# Lấy key tại https://platform.deepseek.com — điền vào `.env` cục bộ, KHÔNG commit key.
DEEPSEEK_API_KEY=
# URL gốc của API DeepSeek (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model generation. Mặc định repo: deepseek-flash (hợp lệ theo docs chính thức
# DeepSeek 2026-10-27; đổi thành deepseek-v4-pro nếu muốn model lớn hơn).
DEEPSEEK_MODEL=deepseek-flash

# --- LLM dự phòng 1: OpenAI (bật khi bỏ trống DEEPSEEK_API_KEY và ta có key này) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM dự phòng 2: Ollama local (bật khi không có key nào ở trên) ---
USE_OLLAMA=1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT=120

# --- Embedding / reranker ---
# Preset truy hồi dày: multilingual_e5 / bge_m3. Embedding model thật được tải từ
# HF vào ~/.cache/huggingface — lần chạy đầu cần mạng, sau đó đặt HF_HUB_OFFLINE=1.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-base
DISABLE_RERANKER=0

# --- V2: API quản trị (bảo vệ bắt buộc) ---
# /admin/reload đòi header `X-Admin-Token: <giá trị này>` sau khi sinh token:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# TRỐNG/bỏ đặt ⇒ API quản trị BỊ TẮT (mọi request nhận 403).
# KHÔNG commit .env thật vào git.
ITLR_ADMIN_TOKEN=

# --- V2: thu thập dữ liệu (crawler) ---
# Cấu hình nguồn crawl (feed/web, license, full_text_allowed...) — mặc định này:
# ITLR_COLLECT_SOURCES=configs/collect.sources.json
# DB SQLite crawler + tổng kết lượt chạy nằm cố định tại var/data/collect/.
# Lệnh cho cron: python scripts/refresh_pipeline.py (crawl → build V2 → probe → activate).
# HF lần đầu cần mạng (model chưa cache): python scripts/refresh_pipeline.py --online

# --- Dữ liệu đầu vào (mặc định var/data/) ---
# ITLR_ITEMS_CSV=var/data/it_learning_items.csv
# ITLR_INTERACTIONS_CSV=var/data/interactions.csv
# Nơi lưu artifacts (mặc định var/artifacts) — dùng để tách sandbox build khi test/multi-env:
# ITLR_ARTIFACTS_DIR=var/artifacts

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# RELOAD=0

# Một worker/replica khi rate limiter trong RAM.
WEB_CONCURRENCY=1
# Production bắt buộc manifest integrity từ builder tin cậy.
ITLR_REQUIRE_ARTIFACT_MANIFEST=1
